{
  "name": "french-blog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/check-privacy.mjs",
    "preview": "astro preview",
    "check:privacy": "node scripts/check-privacy.mjs",
    "og": "node scripts/og-images.mjs",
    "test": "playwright test",
    "qa:links": "node scripts/check-links.mjs",
    "qa:html": "html-validate \"dist/**/*.html\"",
    "qa:lighthouse": "node scripts/lighthouse.mjs",
    "qa": "npm run build && npm run qa:html && npm run qa:links && npm test && npm run qa:lighthouse"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "html-validate": "^11.16.0",
    "lighthouse": "^13.5.0",
    "linkinator": "^8.1.0",
    "typescript": "^6.0.3"
  }
}
