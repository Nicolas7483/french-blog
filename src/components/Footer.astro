---
import LangSwitch from './LangSwitch.astro';
import { SITE_NAME, ui, routes, type Lang, type Alternates } from '../i18n';

interface Props {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const t = ui[lang];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__name">{SITE_NAME}</p>
    <p>{t.footer}</p>
    <ul class="site-footer__links">
      <li><a href={routes.about(lang)}>{t.about}</a></li>
      <li><a href={routes.disclaimer(lang)}>{t.disclaimer}</a></li>
      <li><a href={routes.rss(lang)}>{t.rss}</a></li>
      <li><LangSwitch lang={lang} alternates={alternates} /></li>
    </ul>
  </div>
</footer>
